# ============================================================================
# AI Study Companion — environment template
# Copy to .env and fill in. NEVER commit a populated .env (see .gitignore).
# ============================================================================

# --- Supabase -------------------------------------------------------------
# Project URL and keys from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key. Safe for the browser — RLS is what protects data.
SUPABASE_ANON_KEY=

# Service role key. SERVER/WORKER ONLY. Bypasses RLS entirely.
# Must never be exposed to the frontend or prefixed with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (used by pg-boss for background jobs).
# Supabase Dashboard > Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Postgres schema for the pg-boss queue. Local development shares the same
# database as production, so use a different schema (e.g. pgboss_dev) or a
# locally-run worker will compete with the deployed one for the same jobs.
PGBOSS_SCHEMA=pgboss

# --- Generation provider: Groq (OpenAI-compatible) ------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Grounded Tutor answers — the higher-quality model.
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# Short, high-volume tasks (single-answer grading, single-question generation)
# and automatic failover target when the primary returns an unresolvable 429.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Dashboard rate limits, per model. TPM is the binding constraint, not RPM.
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000

# --- Embedding provider: Gemini -------------------------------------------
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Free tier ceilings. Indexing paces itself under these.
GEMINI_RPM=100
GEMINI_RPD=1000
# Matryoshka truncation target. 768 keeps vectors inside pgvector's 2000-dim
# index limit — see docs/DECISIONS.md (D-004).
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
EMBEDDING_BATCH_DELAY_MS=700

# --- API server -----------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ------------------------------------------------------
# Only VITE_-prefixed vars reach the browser bundle. Never put a secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8080
