    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly"
  },
  "dependencies": {
    "@asc/shared": "*",
    "@google/genai": "^2.22.0",
    "openai": "^7.15.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
