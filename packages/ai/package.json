{
  "name": "@asc/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider abstraction for generation (Groq) and embeddings (Gemini): rate limiting, retry, failover, usage tracking.",
  "main": "./dist/index.js",
